{
  "outputDirectory": "public",
  "functions": {
    "api/ask.js": {
      "maxDuration": 60
    },
    "api/tts.js": {
      "maxDuration": 30
    },
    "api/room.js": {
      "maxDuration": 10
    },
    "api/voz.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/obs/kb/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "cleanUrls": true
}